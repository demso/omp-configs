# Общий несекретный конфиг для first.sh, second.sh и setup.sh.
# Установка:
#   sudo install -o root -g root -m 644 \
#       agent-setup.conf.example /etc/agent-setup.conf
# Редактирование:
#   sudoedit /etc/agent-setup.conf
# Запуск системной настройки:
#   sudo ./first.sh
# Запуск пользовательской настройки:
#   ./second.sh

# Основной Linux-пользователь.
MAIN_USERNAME="koposov"

# Имя профиля Windows в /mnt/c/Users/.
WINDOWS_USERNAME="koposov"

# Пользователь, под которым запускаются агенты.
SECOND_USERNAME="agent"

# Git-настройки для пользователя.
GIT_NAME="Agent"
GIT_EMAIL="agent@example.com"

# Группа доступа к выбранным каталогам C:.
SHARE_GROUP="agent-share"

# Пользовательские зеркала и часовой пояс для setup.sh.
APT_MIRROR="http://mirror.yandex.ru/ubuntu"
PYPI_MIRROR="https://mirror.yandex.ru/pypi/web/simple/"
NPM_REGISTRY="https://registry.npmmirror.com"
TZ_VALUE="Europe/Moscow"

# Общие данные OMP берутся из профиля Windows. Приватные конфиги,
# credentials, базы, сессии и логи внутри .omp остаются локальными для agent.
AGENT_MOUNT_SOURCES=(
    "/home/${SECOND_USERNAME}/.agent-config/omp/agent/models.yml"
    "/home/${SECOND_USERNAME}/.agent-config/omp/agent/RULES.md"
    "/home/${SECOND_USERNAME}/.agent-config/omp/agent/managed-skills"
    "/home/${SECOND_USERNAME}/.agent-config/omp/extensions/superpowers"
    "/mnt/c/Users/${WINDOWS_USERNAME}/.agents"
    "/mnt/c/Users/${WINDOWS_USERNAME}/Downloads"
    "/mnt/c/Users/${WINDOWS_USERNAME}/Documents/ShareX/Screenshots"
)

# Соответствующие точки монтирования внутри /home/SECOND_USERNAME.
AGENT_MOUNT_TARGETS=(
    "/home/${SECOND_USERNAME}/.omp/agent/models.yml"
    "/home/${SECOND_USERNAME}/.omp/agent/RULES.md"
    "/home/${SECOND_USERNAME}/.omp/agent/managed-skills"
    "/home/${SECOND_USERNAME}/.omp/extensions/superpowers"
    "/home/${SECOND_USERNAME}/.agents"
    "/home/${SECOND_USERNAME}/shared/downloads"
    "/home/${SECOND_USERNAME}/shared/screenshots"
)
